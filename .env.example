# RevenueRadar AI — environment variable template
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/revenueradar
DATABASE_USERNAME=revenueradar
DATABASE_PASSWORD=

# --- Server ---
SERVER_PORT=8080
APP_ENV=local

# --- Security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- CORS (comma separated, exact origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4174

# --- AI provider: mock | openai | gemini ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Optional (post-MVP) ---
REDIS_URL=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
